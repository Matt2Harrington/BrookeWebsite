---
import { site } from '../../data/site';
---

<section class="bg-navy text-cream relative overflow-hidden" data-animate>
  <span aria-hidden="true" class="absolute top-10 right-[12%] text-mustard text-3xl animate-spin-slow inline-block">✦</span>
  <span aria-hidden="true" class="absolute bottom-10 left-[8%] text-rose-soft text-2xl animate-float" style="animation-delay: 1.5s">✦</span>
  <span aria-hidden="true" class="absolute top-1/2 left-[15%] text-teal text-2xl animate-spin-reverse inline-block">✺</span>
  <span aria-hidden="true" class="absolute bottom-20 right-[20%] text-coral text-xl animate-float-slow">✦</span>
  <span aria-hidden="true" class="absolute top-1/3 right-[8%] text-mustard text-xl animate-spin-slow inline-block">✦</span>
  <span aria-hidden="true" class="absolute top-16 left-[45%] w-3 h-3 rounded-full bg-mustard animate-float"></span>
  <span aria-hidden="true" class="absolute bottom-32 left-[40%] w-2.5 h-2.5 rounded-full bg-rose-soft animate-float-slow"></span>
  <span aria-hidden="true" class="absolute bottom-16 right-[42%] w-2 h-2 rounded-full bg-teal animate-float" style="animation-delay: 1s"></span>

  <div class="max-w-6xl mx-auto px-6 sm:px-10 py-16 md:py-20 grid md:grid-cols-12 gap-10 items-center relative">
    <div class="md:col-span-7">
      <p class="eyebrow text-rose-soft mb-3">Ready when you are</p>
      <h2 class="font-display font-semibold text-5xl md:text-6xl lg:text-7xl text-cream leading-[1.05] mb-5">
        Let's build something that <span class="marker-rose">actually performs</span>.
      </h2>
      <p class="prose-warm text-cream-deep/80 max-w-xl">
        [EDIT: One concise sentence inviting them to start a project. Mention turnaround or first step.]
      </p>
    </div>
    <div class="md:col-span-5 flex flex-col sm:flex-row md:flex-col gap-3 md:items-end">
      <a href="/contact" class="arrow-link inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-cream text-cocoa text-sm font-medium hover:bg-rose-soft hover:scale-[1.04] active:scale-[0.97] transition-all duration-200 w-full sm:w-auto">
        Start a project
        <svg class="w-4 h-4 arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <a href={`mailto:${site.email}`} class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full border border-cream-deep/30 text-cream-deep text-sm hover:bg-cream/10 hover:text-coral hover:scale-[1.04] active:scale-[0.97] transition-all duration-200 w-full sm:w-auto">
        {site.email}
      </a>
    </div>
  </div>
</section>
