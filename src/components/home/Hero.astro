---
import { site } from '../../data/site';
---

<section class="bg-rose text-cream border-b border-cocoa/20 relative overflow-hidden" data-animate>
  <span aria-hidden="true" class="absolute top-20 right-[10%] text-mustard text-4xl animate-spin-slow inline-block">✦</span>
  <span aria-hidden="true" class="absolute bottom-32 left-[5%] text-cream text-3xl animate-float">✦</span>
  <span aria-hidden="true" class="absolute top-1/3 right-[4%] text-cream-deep text-2xl animate-spin-reverse inline-block">✺</span>
  <span aria-hidden="true" class="absolute bottom-12 right-[28%] text-mustard text-2xl animate-float-slow">✦</span>
  <span aria-hidden="true" class="absolute top-12 left-[40%] text-cream text-xl animate-spin-slow inline-block">✦</span>
  <span aria-hidden="true" class="absolute top-[60%] left-[3%] w-3 h-3 rounded-full bg-mustard animate-float"></span>
  <span aria-hidden="true" class="absolute top-[15%] left-[18%] w-2 h-2 rounded-full bg-cream animate-float-slow"></span>
  <span aria-hidden="true" class="absolute bottom-20 left-[35%] w-2.5 h-2.5 rounded-full bg-cream-deep animate-float" style="animation-delay: 1s"></span>

  <div class="max-w-6xl mx-auto px-6 sm:px-10 pt-16 pb-14 md:pt-24 md:pb-20 grid md:grid-cols-12 gap-10 items-center relative">
    <div class="md:col-span-7 md:order-1 order-2 min-w-0">
      <h1 class="text-6xl sm:text-7xl md:text-8xl lg:text-[7.5rem] text-cream leading-[0.95] mb-6 tracking-tight">
        <span class="word-reveal inline-block" style="animation-delay: 100ms">
          <span class="font-display font-bold">Brookelyn McPherson</span>
        </span>
      </h1>

      <p class="font-display text-2xl md:text-3xl text-cream-deep/90 mb-8 max-w-xl word-reveal" style="animation-delay: 520ms">
        Social Media Managing · Content Creation · Photographer
      </p>

      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm word-reveal" style="animation-delay: 600ms">
        <a href={`mailto:${site.email}`} class="text-cream-deep hover:text-mustard transition-colors arrow-link inline-flex items-center gap-1.5">
          <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2.5 5h15v10h-15z" stroke-linejoin="round" /><path d="M2.5 6l7.5 5 7.5-5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          {site.email}
        </a>
        <a href={site.instagram} target="_blank" rel="noopener noreferrer" class="text-cream-deep hover:text-mustard transition-colors arrow-link inline-flex items-center gap-1.5">
          <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="14" height="14" rx="4" /><circle cx="10" cy="10" r="3.2" /><circle cx="14.5" cy="5.5" r="0.6" fill="currentColor" /></svg>
          {site.instagramHandle}
        </a>
        <a href={site.tiktok} target="_blank" rel="noopener noreferrer" class="text-cream-deep hover:text-mustard transition-colors arrow-link inline-flex items-center gap-1.5">
          <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path d="M14.5 2.5h-2.7v9.6a2.4 2.4 0 11-2.4-2.4v-2.6a5 5 0 105 5V8a6.4 6.4 0 003.7 1.2v-2.6a3.8 3.8 0 01-3.6-4.1z"/></svg>
          {site.tiktokHandle}
        </a>
      </div>
    </div>

    <div class="md:col-span-5 md:order-2 order-1">
      <div class="relative group max-w-sm mx-auto md:max-w-none">
        <div class="bg-cream border border-cocoa-soft/15 rotate-1 shadow-xl p-3 pb-3 transition-transform duration-500 ease-out group-hover:rotate-0 group-hover:scale-[1.02]">
          <div class="aspect-[4/5] overflow-hidden bg-sand/60">
            <img
              src="/images/brooke2.jpeg"
              alt="Brookelyn McPherson"
              class="w-full h-full object-cover"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
