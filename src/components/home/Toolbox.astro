---
// Icons served by Iconify (https://iconify.design).
//   - `logos:*` is a full-color brand set still maintained for these brands.
//   - For brands without a clean logo (CapCut, Final Cut Pro, Pixieset),
//     a generic Remix Icon stands in.
const tools = [
  { name: 'Instagram',        icon: 'logos:instagram-icon' },
  { name: 'TikTok',           icon: 'logos:tiktok-icon' },
  { name: 'Facebook',         icon: 'logos:facebook' },
  { name: 'Canva',            icon: 'simple-icons:canva',       tint: 'F4E4C2' },
  { name: 'Lightroom',        icon: 'logos:adobe-lightroom' },
  { name: 'CapCut',           icon: 'ri:scissors-cut-line',     tint: 'F4E4C2' },
  { name: 'Photoshop',        icon: 'logos:adobe-photoshop' },
  { name: 'Final Cut Pro',    icon: 'ri:movie-2-line',          tint: 'F4E4C2' },
  { name: 'Pixieset',         icon: 'ri:image-2-line',          tint: 'F4E4C2' },
  { name: 'Squarespace',      icon: 'logos:squarespace' },
  { name: 'Google Docs',      icon: 'simple-icons:googledocs',  tint: '4285F4' },
  { name: 'Google Sheets',    icon: 'simple-icons:googlesheets',tint: '34A853' },
  { name: 'Google Analytics', icon: 'logos:google-analytics' },
];

const editsTool = { name: 'Edits' };

const tilts = ['-rotate-2', 'rotate-1', '-rotate-1', 'rotate-2', 'rotate-0', '-rotate-1', 'rotate-1'];

function iconUrl(t: { icon: string; tint?: string }) {
  const base = `https://api.iconify.design/${t.icon}.svg`;
  return t.tint ? `${base}?color=%23${t.tint}` : base;
}
---

<section class="section bg-sage text-cocoa relative overflow-hidden" data-animate>
  <span aria-hidden="true" class="absolute top-12 right-[6%] text-cocoa text-3xl animate-spin-slow inline-block">✦</span>
  <span aria-hidden="true" class="absolute bottom-20 left-[5%] text-rose text-2xl animate-float">✺</span>
  <span aria-hidden="true" class="absolute top-1/3 left-[40%] text-cream text-xl animate-spin-reverse inline-block">✦</span>
  <span aria-hidden="true" class="absolute top-32 right-[40%] w-3 h-3 rounded-full bg-cream animate-float-slow"></span>
  <span aria-hidden="true" class="absolute bottom-16 right-[15%] w-2.5 h-2.5 rounded-full bg-rose animate-float"></span>
  <span aria-hidden="true" class="absolute bottom-12 left-[40%] w-2 h-2 rounded-full bg-mustard animate-float" style="animation-delay: 2s"></span>

  <div class="container-wide relative">
    <div class="text-center mb-12 max-w-3xl mx-auto">
      <h2 class="font-display font-semibold text-5xl md:text-6xl lg:text-7xl text-cocoa leading-[1.05]">
        What's in my <span class="marker is-rose">toolbox?</span>
      </h2>
    </div>

    <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-7 gap-3 md:gap-4 max-w-5xl mx-auto" data-stagger>
      {tools.map((tool, i) => (
        <div class:list={[
          'flex flex-col items-center justify-center gap-2 p-3 text-center transition-transform duration-200 hover:-translate-y-1 hover:rotate-0 hover:scale-110',
          tilts[i % tilts.length],
        ]}>
          <img
            src={iconUrl(tool)}
            alt={tool.name}
            class="w-10 h-10 md:w-12 md:h-12 object-contain"
            loading="lazy"
            decoding="async"
          />
          <span class="text-[11px] md:text-xs font-medium text-cocoa leading-tight">{tool.name}</span>
        </div>
      ))}

      <!-- Edits — generic pencil icon -->
      <div class:list={[
        'flex flex-col items-center justify-center gap-2 p-3 text-center transition-transform duration-200 hover:-translate-y-1 hover:rotate-0 hover:scale-110',
        tilts[tools.length % tilts.length],
      ]}>
        <svg class="w-10 h-10 md:w-12 md:h-12 text-cream" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 20h9" />
          <path d="M16.5 3.5a2.121 2.121 0 113 3L7 19l-4 1 1-4 12.5-12.5z" />
        </svg>
        <span class="text-[11px] md:text-xs font-medium text-cocoa leading-tight">{editsTool.name}</span>
      </div>
    </div>
  </div>
</section>
