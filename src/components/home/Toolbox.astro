---
// Tools styled like stickers stuck to a MacBook lid — varied sizes,
// angles, and vertical offsets so they read as applied by hand.
type Tool =
  | { name: string; icon: string; tint?: string; size: string; angle: number; offsetY: number }
  | { name: string; src: string;                   size: string; angle: number; offsetY: number };

const tools: Tool[] = [
  { name: 'Instagram',        icon: 'logos:instagram-icon',                       size: 'w-20 md:w-28',  angle: -12, offsetY: 6  },
  { name: 'TikTok',           icon: 'logos:tiktok-icon',                          size: 'w-16 md:w-20',  angle: 8,   offsetY: -10 },
  { name: 'Facebook',         icon: 'logos:facebook',                             size: 'w-14 md:w-16',  angle: -5,  offsetY: 4  },
  { name: 'Canva',            icon: 'simple-icons:canva',     tint: '00C4CC',     size: 'w-16 md:w-20',  angle: 14,  offsetY: -6 },
  { name: 'Lightroom',        icon: 'logos:adobe-lightroom',                      size: 'w-14 md:w-18',  angle: -9,  offsetY: 8  },
  { name: 'CapCut',           src:  '/images/tools/capcut.svg',                   size: 'w-28 md:w-40',  angle: 4,   offsetY: 0  },
  { name: 'Photoshop',        icon: 'logos:adobe-photoshop',                      size: 'w-14 md:w-16',  angle: -7,  offsetY: -8 },
  { name: 'Pixieset',         src:  '/images/tools/pixieset.svg',                 size: 'w-32 md:w-48',  angle: 6,   offsetY: 4  },
  { name: 'Edits',            src:  '/images/tools/instagram-edits.svg',          size: 'w-16 md:w-20',  angle: -11, offsetY: -4 },
  { name: 'Squarespace',      icon: 'logos:squarespace',                          size: 'w-16 md:w-20',  angle: 5,   offsetY: 6  },
  { name: 'Google Docs',      icon: 'simple-icons:googledocs',   tint: '4285F4',  size: 'w-12 md:w-14',  angle: -4,  offsetY: -4 },
  { name: 'Google Sheets',    icon: 'simple-icons:googlesheets', tint: '34A853',  size: 'w-12 md:w-14',  angle: 9,   offsetY: 4  },
  { name: 'Google Analytics', icon: 'logos:google-analytics',                     size: 'w-14 md:w-18',  angle: -6,  offsetY: -6 },
];

function iconUrl(t: Extract<Tool, { icon: string }>) {
  const base = `https://api.iconify.design/${t.icon}.svg`;
  return t.tint ? `${base}?color=%23${t.tint}` : base;
}
---

<section class="section bg-cream text-cocoa relative overflow-hidden" data-animate>
  <span aria-hidden="true" class="absolute top-12 right-[6%] text-cocoa text-3xl animate-spin-slow inline-block">✦</span>
  <span aria-hidden="true" class="absolute bottom-20 left-[5%] text-rose text-2xl animate-float">✺</span>
  <span aria-hidden="true" class="absolute top-1/3 left-[40%] text-mustard text-xl animate-spin-reverse inline-block">✦</span>
  <span aria-hidden="true" class="absolute top-32 right-[40%] w-3 h-3 rounded-full bg-teal animate-float-slow"></span>
  <span aria-hidden="true" class="absolute bottom-16 right-[15%] w-2.5 h-2.5 rounded-full bg-rose animate-float"></span>
  <span aria-hidden="true" class="absolute bottom-12 left-[40%] w-2 h-2 rounded-full bg-mustard animate-float" style="animation-delay: 2s"></span>

  <div class="container-wide relative">
    <div class="text-center mb-12 max-w-3xl mx-auto">
      <h2 class="font-display font-semibold text-5xl md:text-6xl lg:text-7xl text-cocoa leading-[1.05]">
        What's in my <span class="marker is-rose">toolbox?</span>
      </h2>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-8 md:gap-x-12 md:gap-y-12 max-w-5xl mx-auto" data-stagger>
      {tools.map((tool) => (
        <div
          class:list={['sticker-shadow shrink-0', tool.size]}
          style={`transform: rotate(${tool.angle}deg) translateY(${tool.offsetY}px);`}
          title={tool.name}
        >
          <img
            src={'src' in tool ? tool.src : iconUrl(tool)}
            alt={tool.name}
            class="w-full h-auto object-contain"
            loading="lazy"
            decoding="async"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Drop-shadow that follows the transparent shape of each sticker SVG/PNG */
  .sticker-shadow img {
    filter:
      drop-shadow(0 1px 0 rgba(255, 255, 255, 0.85))
      drop-shadow(0 3px 4px rgba(0, 0, 0, 0.22));
  }
</style>
