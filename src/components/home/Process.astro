---
const steps = [
  {
    n: '01',
    title: 'Discovery call',
    body: '[EDIT: 20-min intro to understand your brand, goals, and timeline. No pitch — just a conversation.]',
  },
  {
    n: '02',
    title: 'Custom proposal',
    body: '[EDIT: Within 3 days you receive a tailored proposal with deliverables, milestones, and flat-rate pricing.]',
  },
  {
    n: '03',
    title: 'Production',
    body: '[EDIT: Shoot day, content drops, or social calendar — depending on your package. You stay in the loop the whole way.]',
  },
  {
    n: '04',
    title: 'Handoff & support',
    body: '[EDIT: Final files delivered with a usage guide. Two rounds of revisions and 30 days of email support included.]',
  },
];

const tilts = ['-rotate-1', 'rotate-1', '-rotate-1', 'rotate-1'];
---

<section class="section bg-forest text-cream-deep relative overflow-hidden" data-animate>
  <span aria-hidden="true" class="absolute top-10 right-[8%] text-mustard text-3xl animate-spin-slow inline-block">✦</span>
  <span aria-hidden="true" class="absolute bottom-24 left-[5%] text-cream text-2xl animate-float">✺</span>
  <span aria-hidden="true" class="absolute top-1/2 right-[3%] text-rose-soft text-2xl animate-spin-reverse inline-block">✦</span>
  <span aria-hidden="true" class="absolute top-28 left-[40%] w-3 h-3 rounded-full bg-mustard animate-float-slow"></span>
  <span aria-hidden="true" class="absolute bottom-12 right-[42%] w-2.5 h-2.5 rounded-full bg-cream animate-float"></span>
  <span aria-hidden="true" class="absolute top-16 left-[20%] w-2 h-2 rounded-full bg-rose-soft animate-float" style="animation-delay: 1s"></span>

  <div class="container-wide relative">
    <div class="grid md:grid-cols-12 gap-10 mb-12">
      <div class="md:col-span-5">
        <p class="eyebrow text-mustard mb-3">How it works</p>
        <h2 class="font-display font-semibold text-5xl md:text-6xl lg:text-7xl text-cream leading-[1.05]">
          A clear process from <span class="marker is-mustard">hello to handoff</span>
        </h2>
      </div>
      <div class="md:col-span-7 prose-warm text-cream-deep/80">
        <p>[EDIT: Brief 1-2 sentence intro to your process. What makes it different — clear comms, fast turnaround, fixed pricing, etc.]</p>
      </div>
    </div>

    <ol class="grid md:grid-cols-4 gap-5" data-stagger>
      {steps.map((step, i) => (
        <li class:list={[
          'bg-cream text-cocoa border border-cream-deep rounded-2xl p-7 md:p-8 transition-transform duration-300 hover:-translate-y-1 hover:shadow-xl',
          tilts[i % tilts.length],
        ]}>
          <p class="font-display text-4xl text-rose mb-3 font-semibold">{step.n}</p>
          <h3 class="font-display text-xl text-cocoa mb-2 font-semibold">{step.title}</h3>
          <p class="prose-warm text-sm">{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
