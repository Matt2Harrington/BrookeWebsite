---
const testimonials = [
  {
    quote: '[EDIT: A genuine quote from a client about working with you and the impact on their brand or business.]',
    name: '[EDIT: Client Name]',
    role: '[EDIT: Founder, Brand]',
    color: 'text-magenta',
    tilt: '-rotate-1',
  },
  {
    quote: '[EDIT: A second quote — ideally one that hits a different angle, e.g. process or turnaround.]',
    name: '[EDIT: Client Name]',
    role: '[EDIT: Marketing Lead, Brand]',
    color: 'text-coral',
    tilt: 'rotate-1',
  },
  {
    quote: '[EDIT: A third quote — keep these specific and concrete, not generic praise.]',
    name: '[EDIT: Client Name]',
    role: '[EDIT: Owner, Brand]',
    color: 'text-lavender',
    tilt: '-rotate-1',
  },
];
---

<section class="section bg-cocoa text-cream relative overflow-hidden" data-animate>
  <span aria-hidden="true" class="absolute top-14 left-[7%] text-magenta text-3xl animate-spin-reverse inline-block">✺</span>
  <span aria-hidden="true" class="absolute bottom-20 right-[6%] text-mustard text-2xl animate-float">✦</span>
  <span aria-hidden="true" class="absolute top-1/3 right-[10%] text-coral text-xl animate-spin-slow inline-block">✦</span>
  <span aria-hidden="true" class="absolute top-32 right-[40%] w-3 h-3 rounded-full bg-magenta animate-float-slow"></span>
  <span aria-hidden="true" class="absolute bottom-32 left-[42%] w-2.5 h-2.5 rounded-full bg-mustard animate-float"></span>
  <span aria-hidden="true" class="absolute bottom-16 right-[20%] w-2 h-2 rounded-full bg-lavender animate-float" style="animation-delay: 1.5s"></span>

  <div class="container-wide relative">
    <div class="flex items-end justify-between mb-10 pb-6 border-b border-cream/30">
      <div>
        <p class="eyebrow text-mustard mb-3">Kind words</p>
        <h2 class="font-display font-semibold text-5xl md:text-6xl lg:text-7xl text-cream leading-[1.05]">From clients I've <span class="marker is-coral">worked with</span></h2>
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-5" data-stagger>
      {testimonials.map(t => (
        <figure class:list={[
          'bg-cream text-cocoa border border-cream-deep rounded-2xl p-7 flex flex-col transition-transform duration-300 hover:-translate-y-1 hover:shadow-xl',
          t.tilt,
        ]}>
          <svg class:list={['w-8 h-8 mb-4', t.color]} viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
            <path d="M10 8c-3 0-5 2-5 5v11h9V13h-4c0-2 2-3 4-3V8h-4zm14 0c-3 0-5 2-5 5v11h9V13h-4c0-2 2-3 4-3V8h-4z" />
          </svg>
          <blockquote class="prose-warm flex-1 mb-6">
            <p class="text-cocoa text-[1.05rem]">"{t.quote}"</p>
          </blockquote>
          <figcaption class="pt-5 border-t border-cream-deep">
            <p class="font-display text-base text-cocoa font-semibold">{t.name}</p>
            <p class="text-xs uppercase tracking-widest text-cocoa-soft/70 mt-1">{t.role}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
