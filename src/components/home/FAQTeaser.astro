---
const faqs = [
  {
    q: 'Do you travel for shoots?',
    a: 'Yes — based in Greenville, SC, available worldwide. [EDIT: Travel fees apply outside the Carolinas / Southeast.]',
  },
  {
    q: 'How long until I get my content?',
    a: '[EDIT: Most deliverables go out within 2–3 weeks of shoot day.]',
  },
  {
    q: 'Do you offer monthly retainers?',
    a: '[EDIT: Yes — ongoing content & social management starting at [$___]/mo.]',
  },
];
---

<section class="section bg-lavender text-cocoa relative overflow-hidden" data-animate>
  <span aria-hidden="true" class="absolute top-10 right-[5%] text-cream text-3xl animate-spin-reverse inline-block">✺</span>
  <span aria-hidden="true" class="absolute bottom-16 left-[8%] text-forest text-2xl animate-float">✦</span>
  <span aria-hidden="true" class="absolute top-1/2 right-[3%] text-mustard text-xl animate-spin-slow inline-block">✦</span>
  <span aria-hidden="true" class="absolute top-28 left-[40%] w-3 h-3 rounded-full bg-cream animate-float-slow"></span>
  <span aria-hidden="true" class="absolute bottom-24 right-[40%] w-2.5 h-2.5 rounded-full bg-forest animate-float"></span>
  <span aria-hidden="true" class="absolute top-16 left-[12%] w-2 h-2 rounded-full bg-mustard animate-float" style="animation-delay: 2s"></span>

  <div class="container-wide grid md:grid-cols-12 gap-10 relative">
    <div class="md:col-span-4">
      <p class="eyebrow text-cocoa mb-3">FAQ</p>
      <h2 class="font-display font-semibold text-5xl md:text-6xl text-cocoa leading-[1.05] mb-4">
        Common <span class="marker is-forest">questions</span>
      </h2>
      <p class="prose-warm text-cocoa-soft text-sm">
        [EDIT: Short paragraph nudging visitors to send any other questions.]
      </p>
      <a href="/services#faq" class="arrow-link inline-flex items-center gap-2 mt-6 text-sm text-cocoa-soft hover:text-forest transition-colors">
        See all FAQs
        <svg class="w-3 h-3 arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>

    <div class="md:col-span-8">
      <div class="bg-cream rounded-2xl border border-cream-deep divide-y divide-cream-deep px-6" data-stagger>
        {faqs.map(faq => (
          <details class="group">
            <summary class="cursor-pointer list-none py-5 flex items-center justify-between gap-6 font-display text-lg text-cocoa hover:text-rose transition-colors font-semibold">
              {faq.q}
              <span class="text-rose text-xl group-open:rotate-45 transition-transform shrink-0">+</span>
            </summary>
            <div class="pb-5 prose-warm text-sm">{faq.a}</div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
