---
import { projects } from '../../data/projects';

const accentBar = {
  rose: 'bg-rose',
  sage: 'bg-sage',
  sand: 'bg-sand',
  teal: 'bg-teal',
  mustard: 'bg-mustard',
  cobalt: 'bg-cobalt',
  forest: 'bg-forest',
};

const tilts = ['rotate-1', '-rotate-1', 'rotate-0'];
---

<section class="section bg-mustard text-cocoa relative overflow-hidden" data-animate>
  <span aria-hidden="true" class="absolute top-16 left-[6%] text-rose text-3xl animate-spin-reverse inline-block">✺</span>
  <span aria-hidden="true" class="absolute bottom-20 right-[8%] text-cocoa text-2xl animate-float">✦</span>
  <span aria-hidden="true" class="absolute top-1/3 right-[12%] text-cream text-xl animate-spin-slow inline-block">✦</span>
  <span aria-hidden="true" class="absolute top-28 right-[40%] w-3 h-3 rounded-full bg-rose animate-float-slow"></span>
  <span aria-hidden="true" class="absolute bottom-32 left-[45%] w-2.5 h-2.5 rounded-full bg-cocoa animate-float"></span>
  <span aria-hidden="true" class="absolute bottom-12 left-[15%] w-2 h-2 rounded-full bg-rose-soft animate-float" style="animation-delay: 2s"></span>

  <div class="container-wide relative">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 pb-6 border-b border-cocoa/20">
      <div>
        <p class="eyebrow text-rose mb-3">Selected work</p>
        <h2 class="font-display font-semibold text-5xl md:text-6xl lg:text-7xl text-cocoa leading-[1.05]">
          Projects I'm <span class="marker is-rose">proud of</span>
        </h2>
      </div>
      <a href="/portfolio" class="arrow-link text-sm text-cocoa-soft hover:text-rose transition-colors inline-flex items-center gap-2">
        View full portfolio
        <svg class="w-3 h-3 arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>

    <div class="grid md:grid-cols-3 gap-5" data-stagger>
      {projects.map((project, i) => (
        <a
          href={project.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[
            'group relative bg-cream text-cocoa p-7 flex flex-col border border-cream-deep rounded-2xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl',
            tilts[i % tilts.length],
          ]}
        >
          <span class:list={['absolute top-0 left-7 right-7 h-1 rounded-b-sm', accentBar[project.accent]]}></span>
          <p class="text-xs uppercase tracking-widest text-cocoa-soft/70 mb-4 mt-1">{project.category}</p>
          <h3 class="font-display text-2xl text-cocoa mb-2 group-hover:text-rose transition-colors font-semibold">
            {project.title}
          </h3>
          <p class="text-sm text-cocoa-soft mb-4">{project.role}</p>
          <p class="prose-warm text-sm flex-1 mb-6">{project.short}</p>
          <span class="mt-auto text-xs uppercase tracking-widest text-rose inline-flex items-center gap-2 arrow-link">
            {project.handle}
            <svg class="w-3 h-3 arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
