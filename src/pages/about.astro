---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const facts = [
  { label: 'Based in', value: 'Greenville, SC' },
  { label: 'Education', value: 'UNC Asheville &middot; Arts Management' },
  { label: 'Camera', value: 'Canon R6' },
  { label: 'Started shooting', value: 'As a teenager &middot; point-and-shoot' },
  { label: 'Available for', value: 'Projects worldwide' },
  { label: 'Response time', value: '< 48 hours' },
];

const offerings = [
  { title: 'Photography', body: 'Editorial portrait, brand, and travel shoots.' },
  { title: 'Content creation', body: 'UGC, reels, lifestyle photo and video.' },
  { title: 'Marketing strategy', body: 'Calendars, growth strategy, and campaign planning.' },
];
---

<BaseLayout title={`About — ${site.name}`}>
  <!-- Hero (rose) -->
  <section class="bg-rose text-cream border-b border-cocoa/20 relative overflow-hidden" data-animate>
    <span aria-hidden="true" class="absolute top-20 right-[10%] text-mustard text-4xl animate-spin-slow inline-block">✦</span>
    <span aria-hidden="true" class="absolute bottom-20 left-[5%] text-cream text-3xl animate-float">✦</span>
    <span aria-hidden="true" class="absolute top-1/3 right-[5%] text-cream-deep text-2xl animate-spin-reverse inline-block">✺</span>
    <span aria-hidden="true" class="absolute top-[60%] left-[12%] w-3 h-3 rounded-full bg-mustard animate-float"></span>
    <span aria-hidden="true" class="absolute top-12 left-[40%] w-2 h-2 rounded-full bg-cream animate-float-slow"></span>

    <div class="max-w-6xl mx-auto px-6 sm:px-10 pt-16 pb-14 md:pt-24 md:pb-20 grid md:grid-cols-12 gap-10 items-center relative">
      <div class="md:col-span-7 md:order-1 order-2 min-w-0">
        <p class="eyebrow text-mustard mb-4">About</p>
        <h1 class="text-6xl sm:text-7xl md:text-8xl text-cream leading-[0.95] mb-6 tracking-tight">
          <span class="word-reveal inline-block" style="animation-delay: 100ms">
            <span class="font-display font-bold">Brookelyn.</span>
          </span>
        </h1>
        <p class="font-display italic text-2xl md:text-3xl text-cream-deep/90 mb-8 max-w-xl word-reveal" style="animation-delay: 480ms">
          Storyteller, strategist, photographer.
        </p>
        <p class="prose-warm text-cream-deep/80 text-lg max-w-xl word-reveal" style="animation-delay: 600ms">
          A short version: I help brands turn ideas into campaigns that look beautiful and
          actually perform. The longer version is below.
        </p>
      </div>

      <div class="md:col-span-5 md:order-2 order-1">
        <div class="relative group max-w-sm mx-auto md:max-w-none">
          <div class="bg-cream border border-cocoa-soft/15 rotate-1 shadow-xl p-3 pb-12 transition-transform duration-500 ease-out group-hover:rotate-0 group-hover:scale-[1.02]">
            <div class="aspect-[4/5] overflow-hidden bg-sand/60">
              <img
                src="/images/brooke.jpg"
                alt="Brookelyn McPherson"
                class="w-full h-full object-cover"
              />
            </div>
            <p class="absolute bottom-3 left-0 right-0 text-center font-script text-cocoa text-2xl">brookelyn ✿</p>
          </div>
          <span aria-hidden="true" class="absolute -top-6 -right-4 text-mustard text-3xl animate-spin-slow inline-block">✦</span>
          <div aria-hidden="true" class="absolute -top-4 -left-6 z-10 badge bg-mustard text-cocoa" style="--bob-rot: -10deg">
            hi!
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Story (cream) -->
  <section class="section bg-cream relative overflow-hidden" data-animate>
    <span aria-hidden="true" class="absolute top-12 right-[8%] text-rose text-2xl animate-spin-slow inline-block">✦</span>
    <span aria-hidden="true" class="absolute bottom-20 left-[5%] text-teal text-xl animate-float">✺</span>
    <span aria-hidden="true" class="absolute top-1/2 right-[10%] w-3 h-3 rounded-full bg-mustard animate-float-slow"></span>

    <div class="container-wide grid md:grid-cols-12 gap-10 items-start relative">
      <div class="md:col-span-5">
        <p class="eyebrow mb-3">My story</p>
        <h2 class="font-display font-semibold text-5xl md:text-6xl lg:text-7xl text-cocoa leading-[1.05]">
          From point-and-shoot to <span class="marker is-teal">brand strategy</span>
        </h2>
      </div>
      <div class="md:col-span-7 prose-warm space-y-5 text-[1.05rem]">
        <p>
          I'm a photographer, marketing strategist, and content creator passionate about
          building content for brands that resonates and fits their vibe.
        </p>
        <p>
          I started photography with my little point-and-shoot as a teenager just capturing
          raw, candid shots of my friends and my travels. Slowly upgraded to a professional
          camera and graduated from UNC Asheville with a degree in Arts Management. With
          that, I learned marketing and content creation strategies through working with
          different businesses and with marketing my own photography business.
        </p>
        <p>
          With a blend of creative storytelling and data-driven strategy, I help businesses
          turn ideas into impactful campaigns that drive engagement, growth, and brand
          loyalty. From capturing compelling visuals to developing content and marketing
          strategies that resonate across platforms, I bring both creativity and strategy
          to every project. My work is centered on creating authentic experiences that not
          only look great but deliver real results.
        </p>
      </div>
    </div>
  </section>

  <!-- Quick facts (forest) -->
  <section class="section bg-forest text-cream-deep relative overflow-hidden" data-animate>
    <span aria-hidden="true" class="absolute top-10 right-[8%] text-mustard text-3xl animate-spin-slow inline-block">✦</span>
    <span aria-hidden="true" class="absolute bottom-16 left-[6%] text-cream text-2xl animate-float">✺</span>
    <span aria-hidden="true" class="absolute top-1/2 right-[3%] text-rose-soft text-xl animate-spin-reverse inline-block">✦</span>
    <span aria-hidden="true" class="absolute top-28 left-[40%] w-3 h-3 rounded-full bg-mustard animate-float-slow"></span>

    <div class="container-wide grid md:grid-cols-12 gap-10 relative">
      <div class="md:col-span-4">
        <p class="eyebrow text-mustard mb-3">Quick facts</p>
        <h2 class="font-display font-semibold text-5xl md:text-6xl text-cream leading-[1.05]">The <span class="marker is-mustard">details</span></h2>
      </div>
      <dl class="md:col-span-8 grid sm:grid-cols-2 gap-5" data-stagger>
        {facts.map(f => (
          <div class="bg-cream text-cocoa border border-cream-deep rounded-2xl p-6">
            <dt class="text-xs uppercase tracking-widest text-cocoa-soft/70 mb-2">{f.label}</dt>
            <dd class="font-display text-xl text-cocoa font-semibold" set:html={f.value}></dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- What I offer (mustard) -->
  <section class="section bg-mustard text-cocoa relative overflow-hidden" data-animate>
    <span aria-hidden="true" class="absolute top-12 left-[6%] text-rose text-3xl animate-spin-reverse inline-block">✺</span>
    <span aria-hidden="true" class="absolute bottom-20 right-[8%] text-cocoa text-2xl animate-float">✦</span>
    <span aria-hidden="true" class="absolute top-32 right-[40%] w-3 h-3 rounded-full bg-rose animate-float-slow"></span>

    <div class="container-wide relative">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 pb-6 border-b border-cocoa/20">
        <div>
          <p class="eyebrow text-rose mb-3">What I offer</p>
          <h2 class="font-display font-semibold text-5xl md:text-6xl lg:text-7xl text-cocoa leading-[1.05]">A quick <span class="marker is-rose">overview</span></h2>
        </div>
        <a href="/services" class="arrow-link text-sm text-cocoa-soft hover:text-rose transition-colors inline-flex items-center gap-2">
          See full services
          <svg class="w-3 h-3 arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
      <div class="grid md:grid-cols-3 gap-5" data-stagger>
        {offerings.map((o, i) => (
          <div class="bg-cream text-cocoa border border-cream-deep rounded-2xl p-7">
            <p class="text-xs text-cocoa-soft/70 tracking-widest mb-3">0{i + 1}</p>
            <h3 class="font-display text-2xl text-cocoa mb-2 font-semibold">{o.title}</h3>
            <p class="prose-warm text-sm">{o.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA (navy) -->
  <section class="bg-navy text-cream relative overflow-hidden" data-animate>
    <span aria-hidden="true" class="absolute top-10 right-[12%] text-mustard text-3xl animate-spin-slow inline-block">✦</span>
    <span aria-hidden="true" class="absolute bottom-10 left-[8%] text-rose-soft text-2xl animate-float">✦</span>

    <div class="max-w-6xl mx-auto px-6 sm:px-10 py-16 md:py-20 grid md:grid-cols-12 gap-10 items-center relative">
      <div class="md:col-span-7">
        <p class="eyebrow text-rose-soft mb-3">Let's work together</p>
        <h2 class="font-display font-semibold text-5xl md:text-6xl lg:text-7xl text-cream leading-[1.05]">
          Got a <span class="marker-rose">project in mind</span>?
        </h2>
        <p class="prose-warm text-cream-deep/80 max-w-xl mt-5">
          Send a quick note about your brand, your goals, and your timeline. I'll get back within 48 hours.
        </p>
      </div>
      <div class="md:col-span-5 flex flex-col sm:flex-row md:flex-col gap-3 md:items-end">
        <a href="/contact" class="arrow-link inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full bg-cream text-cocoa text-base font-medium hover:text-rose active:scale-[0.97] transition-all duration-200 w-full sm:w-auto">
          Start a project
          <svg class="w-4 h-4 arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a href={`mailto:${site.email}`} class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-full border-2 border-cream-deep/30 text-cream-deep text-base hover:bg-cream/10 hover:text-coral active:scale-[0.97] transition-all duration-200 w-full sm:w-auto">
          {site.email}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
