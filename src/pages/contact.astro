---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const inquiryTypes = [
  'Content Creation',
  'Social Media Management',
  'Photography',
  'Marketing strategy',
  'Just saying hi',
];
---

<BaseLayout title={`Contact — ${site.name}`}>
  <!-- Hero (rose) -->
  <section class="bg-rose text-cream border-b border-cocoa/20 relative overflow-hidden" data-animate>
    <span aria-hidden="true" class="absolute top-20 right-[10%] text-mustard text-4xl animate-spin-slow inline-block">✦</span>
    <span aria-hidden="true" class="absolute bottom-12 left-[8%] text-cream text-3xl animate-float">✦</span>
    <span aria-hidden="true" class="absolute top-1/2 right-[4%] text-cream-deep text-2xl animate-spin-reverse inline-block">✺</span>
    <span aria-hidden="true" class="absolute top-12 left-[40%] w-2 h-2 rounded-full bg-cream animate-float-slow"></span>
    <span aria-hidden="true" class="absolute bottom-16 right-[28%] w-3 h-3 rounded-full bg-mustard animate-float"></span>

    <div class="container-tight px-6 sm:px-10 pt-20 pb-16 md:pt-28 md:pb-20 relative text-center">
      <h1 class="font-display font-bold text-6xl sm:text-7xl md:text-8xl text-cream leading-[0.95] tracking-tight">
        <span class="word-reveal inline-block" style="animation-delay: 100ms">Let's</span>
        <span class="word-reveal inline-block italic font-medium" style="animation-delay: 240ms">work together.</span>
      </h1>
    </div>
  </section>

  <!-- Form + Side info (cream) -->
  <section class="section bg-cream relative overflow-hidden">
    <span aria-hidden="true" class="absolute top-12 right-[8%] text-rose text-2xl animate-spin-slow inline-block">✦</span>
    <span aria-hidden="true" class="absolute bottom-20 left-[5%] text-teal text-xl animate-float">✺</span>
    <span aria-hidden="true" class="absolute top-1/2 right-[10%] w-3 h-3 rounded-full bg-mustard animate-float-slow"></span>

    <div class="max-w-2xl mx-auto px-6 sm:px-10 relative">
      <!-- Form card -->
      <div class="bg-cream-deep/30 rounded-3xl border border-cream-deep p-8 md:p-10">
        <h2 class="font-display font-semibold text-4xl md:text-5xl text-cocoa mb-6 leading-[1.05]">Inquiry <span class="marker is-rose">form</span></h2>

        <form
          action={`mailto:${site.email}`}
          method="post"
          enctype="text/plain"
          class="space-y-5"
        >
          <div class="grid sm:grid-cols-2 gap-5">
            <label class="block">
              <span class="eyebrow block mb-2">Your name</span>
              <input
                required
                type="text"
                name="name"
                class="w-full px-4 py-3 rounded-xl bg-cream border border-cream-deep focus:border-rose focus:outline-none transition-colors"
              />
            </label>
            <label class="block">
              <span class="eyebrow block mb-2">Email</span>
              <input
                required
                type="email"
                name="email"
                class="w-full px-4 py-3 rounded-xl bg-cream border border-cream-deep focus:border-rose focus:outline-none transition-colors"
              />
            </label>
          </div>

          <label class="block">
            <span class="eyebrow block mb-2">What are you interested in?</span>
            <select
              name="interest"
              class="w-full px-4 py-3 rounded-xl bg-cream border border-cream-deep focus:border-rose focus:outline-none transition-colors"
            >
              {inquiryTypes.map((t) => <option>{t}</option>)}
            </select>
          </label>

          <label class="block">
            <span class="eyebrow block mb-2">Tell me more</span>
            <textarea
              required
              rows="6"
              name="message"
              placeholder="Share your ideas!"
              class="w-full px-4 py-3 rounded-xl bg-cream border border-cream-deep focus:border-rose focus:outline-none transition-colors resize-none"
            ></textarea>
          </label>

          <div class="flex justify-center pt-2">
            <button type="submit" class="arrow-link inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-cocoa text-cream text-base font-medium hover:bg-rose active:scale-[0.97] transition-all duration-200">
              Send it
              <svg class="w-4 h-4 arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </div>

        </form>
      </div>

    </div>
  </section>

</BaseLayout>
